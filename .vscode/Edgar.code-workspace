{
  "folders": [
    {
      "name": "📁 Root",
      "path": ".."
    },
    {
      "name": "📁 src",
      "path": "../src/edgar"
    }
  ],
  "settings": {
    "explorer.autoReveal": false,
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.extraPaths": ["${workspaceFolder:📁 Root}/src"],
    "python.defaultInterpreterPath": "${workspaceFolder:📁 Root}/.venv/Scripts/python.exe",
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.venv": true,
      "**/*.egg-info": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/logs": true,
      "**/.git": true,
      "**/.venv": true,
      "**/data": true,
      "**/*.egg-info": true
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.associations": {
      "*.env.example": "properties",
      ".env": "properties"
    }
  }
}
